#!/usr/bin/env bash
#MISE description="Install the binaries, helper, polkit policy and desktop entry"
#
# `mise run build` first. Runs without mise as well, which is how the
# PKGBUILD and the release tarball use it:
#
#   sudo ./mise-tasks/install
#   DESTDIR="$pkgdir" PREFIX=/usr ./mise-tasks/install
#
# The helper goes to libexec rather than bin: it is not a command anyone
# should run, and the polkit policy names that exact path.
set -euo pipefail

cd "$(dirname "$0")/.."

# Only /usr. The application looks for the helper at
# /usr/lib/limpid/limpid-helper, the polkit policy authorises that exact
# path, and polkit reads policies only from /usr/share/polkit-1/actions. Under
# any other prefix the install would finish without complaint and every
# operation needing root would quietly stop working, so it is refused before
# anything is copied. The path is fixed on purpose: where the root binary
# lives is not something to make configurable. DESTDIR still stages the /usr
# tree somewhere else, which is what packaging needs.
install_prefix="${PREFIX:-/usr}"
install_prefix="${install_prefix%/}"
if [[ "$install_prefix" != /usr ]]; then
  echo "install: PREFIX=$install_prefix is not supported, only /usr." >&2
  echo "install: the privileged helper and its polkit policy only work there." >&2
  exit 1
fi

prefix="${DESTDIR:-}${install_prefix}"
target=target/release

install -Dm755 "$target/limpid"        "$prefix/bin/limpid"
install -Dm755 "$target/limpid-cli"    "$prefix/bin/limpid-cli"
install -Dm755 "$target/limpid-helper" "$prefix/lib/limpid/limpid-helper"
install -Dm644 data/org.limpid.helper.policy "$prefix/share/polkit-1/actions/org.limpid.helper.policy"
install -Dm644 data/limpid.desktop     "$prefix/share/applications/limpid.desktop"
install -Dm644 data/limpid.svg         "$prefix/share/icons/hicolor/scalable/apps/limpid.svg"
install -Dm644 LICENSE                 "$prefix/share/licenses/limpid/LICENSE"

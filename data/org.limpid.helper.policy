<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<policyconfig>
  <vendor>Limpid</vendor>
  <vendor_url>https://github.com/heroesofcode/limpid</vendor_url>

  <!--
    One action for the whole helper rather than one per operation. The helper
    takes a fixed set of named operations and no paths at all, so a finer
    grain would only mean more prompts for the same authority.
  -->
  <action id="org.limpid.helper.run">
    <description>Clean system files</description>
    <message>Authentication is required to remove system caches, logs and crash dumps</message>
    <icon_name>user-trash</icon_name>

    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <!--
        keep, not auth_admin, so a run of several operations asks once rather
        than once per operation. The authorisation lapses with the session.
      -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/limpid/limpid-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
